<mvc:View controllerName="monitorincidents.controller.ListReport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <Table id="incidentsTable" 
            items="{path: '/ListOfIncidents'}">
                <headerToolbar>
                    <Toolbar id="incidentsToolbar">
                        <Title id="incidentsTitle" text="Incidents"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="columnId"><Text id="columnIdText" text="ID"/></Column>
                    <Column id="columnTitle"><Text id="columnTitleText" text="Title"/></Column>
                    <Column id="columnCustomer"><Text id="columnCustomerText" text="Customer"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="incidentsRow">
                        <cells>
                            <Text id="cellId" text="{ID}"/>
                            <Text id="cellTitle" text="{title}"/>
                            <Text id="cellCustomer" text="{customer/name}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Table id="itemsTable" items="{path: '/Items'}">
                <headerToolbar>
                    <Toolbar id="itemsToolbar">
                        <Title id="itemsTitle" text="Items"/>
                        <ToolbarSpacer id="itemsToolbarSpacer"/>
                        <Button id="createItemBtn" text="Create Item" press=".onOpenCreateItemDialog"/>
                        <Button id="searchByQuantityBtn" text="Search by Quantity" press=".onOpenSearchByQuantityDialog"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="itemColumnTitle"><Text id="itemColumnTitleText" text="Title"/></Column>
                    <Column id="itemColumnDescr"><Text id="itemColumnDescrText" text="Description"/></Column>
                    <Column id="itemColumnQty"><Text id="itemColumnQtyText" text="Quantity"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="itemsRow">
                        <cells>
                            <Text id="itemCellTitle" text="{title}"/>
                            <Text id="itemCellDescr" text="{descr}"/>
                            <Text id="itemCellQty" text="{quantity}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>

    <Dialog id="createItemDialog" title="Create Item">
        <content>
            <VBox id="createItemVBox" class="sapUiSmallMargin">
                <Input id="inputTitle" placeholder="Title"/>
                <Input id="inputDescr" placeholder="Description" class="sapUiSmallMarginTop"/>
                <Input id="inputQuantity" placeholder="Quantity" type="Number" class="sapUiSmallMarginTop"/>
            </VBox>
        </content>
        <beginButton>
            <Button id="createItemConfirmBtn" text="Create" type="Emphasized" press=".onCreateItem"/>
        </beginButton>
        <endButton>
            <Button id="createItemCancelBtn" text="Cancel" press=".onCloseCreateItemDialog"/>
        </endButton>
    </Dialog>

    <Dialog id="searchByQuantityDialog" title="Search by Quantity">
        <content>
            <VBox id="searchByQuantityVBox" class="sapUiSmallMargin">
                <Input id="inputSearchQuantity" placeholder="Quantity" type="Number"/>
            </VBox>
        </content>
        <beginButton>
            <Button id="searchByQuantityConfirmBtn" text="Search" type="Emphasized" press=".onSearchByQuantity"/>
        </beginButton>
        <endButton>
            <Button id="searchByQuantityCancelBtn" text="Cancel" press=".onCloseSearchByQuantityDialog"/>
        </endButton>
    </Dialog>
</mvc:View>
